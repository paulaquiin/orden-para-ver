{
  "name": "orden-para-ver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ai": "npm run build && npm run preview",
    "build": "vite build",
    "check:wordpress": "node scripts/check-wordpress.js",
    "check:blog": "node scripts/verify-blog.js",
    "test:blog": "node --test tests/blog/*.test.js",
    "preview": "wrangler pages dev dist --compatibility-date=2026-05-01 --compatibility-flag=nodejs_compat"
  },
  "devDependencies": {
    "vite": "^8.0.4",
    "wrangler": "^4.85.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "he": "^2.0.0",
    "sanitize-html": "^2.18.1"
  }
}
